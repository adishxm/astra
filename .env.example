# ASTRA Configuration Environment Variables
# Copy to .env for local environment overrides

# Application Mode & Security
ASTRA_ENV=development
ASTRA_DEBUG=true
ASTRA_HOST=0.0.0.0
ASTRA_PORT=8000
ASTRA_DEFAULT_TENANT_ID=default-tenant
ASTRA_DEFAULT_USER_ID=local-user

# Intake Limits
MAX_ARCHIVE_SIZE_BYTES=104857600       # 100 MB
MAX_UNCOMPRESSED_SIZE_BYTES=524288000  # 500 MB
MAX_FILE_COUNT=10000
MAX_COMPRESSION_RATIO=100              # 100:1 Zip bomb cutoff

# Cryptographic Risk Scenarios Defaults
DEFAULT_CRQC_HORIZON_YEARS=7.0         # Mosca threat horizon Z (default: 7.0 years)
MIGRATION_HORIZON_SLIDER_MIN=1.0
MIGRATION_HORIZON_SLIDER_MAX=20.0

# Storage Paths
TEMP_SCANS_DIR=temp_scans
SANDBOX_TMP_DIR=sandbox_tmp
